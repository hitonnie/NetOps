{
  "name": "netops-sim",
  "productName": "NetOps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NetOps: Office Network Engineer — a NOC / CCNA troubleshooting simulation game",
  "author": "Tonny",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "icons": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.hitonnie.netops",
    "productName": "NetOps",
    "copyright": "Copyright © 2026 Tonny",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "NetOps"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetOps",
      "uninstallDisplayName": "NetOps: Office Network Engineer",
      "artifactName": "NetOps-Setup-${version}.exe"
    }
  }
}
